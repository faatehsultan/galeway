{
  "name": "galeway-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api-types": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts",
    "docs:lint": "markdownlint-cli2"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.108.4",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "markdownlint-cli2": "0.24.2",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "size-limit": [
    {
      "name": "Initial JS (gzip)",
      "path": "dist/assets/index-*.js",
      "limit": "180 kB",
      "gzip": true
    }
  ]
}
